# ConduitVPN compose 环境变量（复制为 .env 后填写）

# 管理后台：生产环境必须提供账号、至少 16 字符密码和 TLS 证书。
UI_USER=admin
UI_PASSWORD=请替换为至少16字符的随机密码
UI_TLS_CERT=/run/conduitvpn-tls/cert.pem
UI_TLS_KEY=/run/conduitvpn-tls/key.pem
UI_TLS_CERT_HOST=/absolute/path/to/fullchain.pem
UI_TLS_KEY_HOST=/absolute/path/to/privkey.pem

# 容器内必须监听全部网卡以支持 Docker 端口映射；TLS 和代理认证仍由程序强制。
UI_HOST=0.0.0.0
LOCAL_PROXY_HOST=0.0.0.0
LOCAL_PROXY_USER=proxy
LOCAL_PROXY_PASS=请替换为至少16字符的随机密码

# hy2 入站（UDP），默认关闭；启用时密码至少 16 字符。
HY2_PORT=0
# HY2_PASSWORD=请替换为至少16字符的随机密码

# 可选：节点拉取走 sing-box 单节点 / 订阅
# UPSTREAM_SINGBOX_URI=vless://...
# UPSTREAM_SUBSCRIPTION=https://...
